__snyk_kernel = $(shell uname -s | tr "[:upper:]" "[:lower:]" | sed -e 's/darwin/macos/')
__snyk_arch = $(shell uname -m | sed -e 's/x86_64//' -e 's/arm64/-arm64/' -e 's/aarch64/-arm64/')
