sso_role_name = AdministratorAccess
region = us-east-1
endef
export __aws_config
__aws_dir = $(TOOLS_DIR)/aws
AWS_CONFIG_FILE = $(__aws_dir)/config
$(__aws_dir):
	@mkdir -p $@
$(AWS_CONFIG_FILE): $(__aws_dir)
	@echo "Setting a config file for AWS CLI"
	@echo "$$__aws_config" > $@
__aws_not_logged_in_message = "The SSO session associated with this profile has expired or is otherwise invalid. Please run 'AWS_CONFIG_FILE=$(AWS_CONFIG_FILE) aws sso login --profile infraprod' to refresh the session."
define __aws_login_script
[ -n "$$CI" ] || ( \
  $(AWS) sts get-caller-identity > /dev/null 2>&1 \
  || ( \
    echo "$(__aws_not_logged_in_message)" \
    && $(AWS) sso login \
    ) \
  )
endef
aws_login = $(__aws_login_script)
.d.aws: $(AWS_CONFIG_FILE)
.PHONY: .d.aws

# SOURCE: https://github.com/devrev/sidekick/blob/main/internal/component/data/docker
DOCKER_BUILD_EXTRA_ARGS ?=
DOCKER_BUILD_REGISTRY ?=
DOCKER_BUILD_TAG ?= build
DOCKER ?= docker
docker_build = $(DOCKER) buildx build \
  --progress plain \
  --ssh default \
  --tag $(DOCKER_BUILD_REGISTRY)$(1):$(DOCKER_BUILD_TAG) \
  --label org.opencontainers.image.source=https://github.com/devrev/$(PROJECT_NAME) \
  --label org.opencontainers.image.revision=$(GIT_SHA) \
  --label org.opencontainers.image.created=$(shell date -u +'%Y-%m-%dT%H:%M:%SZ') \
  --label ai.devrev.ci=$(CIRCLECI) \
  --label ai.devrev.ci.job.name=$(CIRCLE_JOB) \
  --label ai.devrev.ci.job.id=$(CIRCLE_WORKFLOW_ID) \
  --label ai.devrev.ci.job.number=$(CIRCLE_BUILD_NUM) \
  --label ai.devrev.ci.job.url=$(CIRCLE_BUILD_URL) \
  --label ai.devrev.ci.job.pr.url=$(CIRCLE_PULL_REQUEST) \
  $(DOCKER_BUILD_EXTRA_ARGS)
DOCKER_REGISTRY ?= 173672169127.dkr.ecr.us-east-1.amazonaws.com
DOCKER_AWS_PROFILE ?= infraprod
DOCKER_FORCE_NO_AUTH ?= false
.d.docker.ecr-login: .d.aws
	@if [ -z $${CI+x} ]; then \
	  export AWS_PROFILE=$(DOCKER_AWS_PROFILE); \
	  $(call aws_login); \
	  $(AWS) ecr get-login-password \
	    | $(DOCKER) login --username AWS --password-stdin $(DOCKER_REGISTRY); \
	else \
	  if [ -z "$${INFRA_AWS_ACCESS_KEY_ID+x}" ] || [ -z "$${INFRA_AWS_SECRET_ACCESS_KEY+x}" ]; then \
	    echo "$(__text_bold)$(__text_color_red)ERROR: INFRA_AWS variables missing! Make sure to use aws-infra-ecr context!$(__text_normal)"; \
	    exit 1; \
	  fi; \
	  export AWS_SECRET_ACCESS_KEY=$(INFRA_AWS_SECRET_ACCESS_KEY); \
	  export AWS_ACCESS_KEY_ID=$(INFRA_AWS_ACCESS_KEY_ID); \
	  $(AWS) ecr get-login-password \
	    | $(DOCKER) login --username AWS --password-stdin $(DOCKER_REGISTRY); \
	fi
.PHONY: .d.docker.ecr-login
.d.docker.bin:
.PHONY: .d.docker.bin
.d.docker:
	@if [ "$(DOCKER_FORCE_NO_AUTH)" = "true" ]; then \
		echo "Skipping ECR authentication"; \
	else \
		$(MAKE) .d.docker.ecr-login; \
	fi
.PHONY: .d.docker
